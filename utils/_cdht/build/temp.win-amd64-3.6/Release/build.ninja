ninja_required_version = 1.3
cxx = cl
nvcc = C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v11.8\bin\nvcc

cflags = /nologo /Ox /W3 /GL /DNDEBUG /MD /MD /wd4819 /wd4251 /wd4244 /wd4267 /wd4275 /wd4018 /wd4190 /EHsc -ID:\Softwares\Py\anaconda3\envs\wakenet\lib\site-packages\torch\include -ID:\Softwares\Py\anaconda3\envs\wakenet\lib\site-packages\torch\include\torch\csrc\api\include -ID:\Softwares\Py\anaconda3\envs\wakenet\lib\site-packages\torch\include\TH -ID:\Softwares\Py\anaconda3\envs\wakenet\lib\site-packages\torch\include\THC "-IC:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v11.8\include" -ID:\Softwares\Py\anaconda3\envs\wakenet\include -ID:\Softwares\Py\anaconda3\envs\wakenet\include -ID:\Softwares\VS\VC\Tools\MSVC\14.42.34433\include -ID:\Softwares\VS\VC\Auxiliary\VS\include "-IC:\Program Files (x86)\Windows Kits\10\include\10.0.22621.0\ucrt" "-IC:\Program Files (x86)\Windows Kits\10\\include\10.0.22621.0\\um" "-IC:\Program Files (x86)\Windows Kits\10\\include\10.0.22621.0\\shared" "-IC:\Program Files (x86)\Windows Kits\10\\include\10.0.22621.0\\winrt" "-IC:\Program Files (x86)\Windows Kits\10\\include\10.0.22621.0\\cppwinrt"
post_cflags = -g -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=deep_hough -D_GLIBCXX_USE_CXX11_ABI=0 /std:c++14
cuda_cflags = -Xcompiler /MD -Xcompiler /wd4819 -Xcompiler /wd4251 -Xcompiler /wd4244 -Xcompiler /wd4267 -Xcompiler /wd4275 -Xcompiler /wd4018 -Xcompiler /wd4190 -Xcompiler /EHsc -Xcudafe --diag_suppress=base_class_has_different_dll_interface -Xcudafe --diag_suppress=field_without_dll_interface -Xcudafe --diag_suppress=dll_interface_conflict_none_assumed -Xcudafe --diag_suppress=dll_interface_conflict_dllexport_assumed -ID:\Softwares\Py\anaconda3\envs\wakenet\lib\site-packages\torch\include -ID:\Softwares\Py\anaconda3\envs\wakenet\lib\site-packages\torch\include\torch\csrc\api\include -ID:\Softwares\Py\anaconda3\envs\wakenet\lib\site-packages\torch\include\TH -ID:\Softwares\Py\anaconda3\envs\wakenet\lib\site-packages\torch\include\THC "-IC:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v11.8\include" -ID:\Softwares\Py\anaconda3\envs\wakenet\include -ID:\Softwares\Py\anaconda3\envs\wakenet\include -ID:\Softwares\VS\VC\Tools\MSVC\14.42.34433\include -ID:\Softwares\VS\VC\Auxiliary\VS\include "-IC:\Program Files (x86)\Windows Kits\10\include\10.0.22621.0\ucrt" "-IC:\Program Files (x86)\Windows Kits\10\\include\10.0.22621.0\\um" "-IC:\Program Files (x86)\Windows Kits\10\\include\10.0.22621.0\\shared" "-IC:\Program Files (x86)\Windows Kits\10\\include\10.0.22621.0\\winrt" "-IC:\Program Files (x86)\Windows Kits\10\\include\10.0.22621.0\\cppwinrt"
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -arch=sm_80 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=deep_hough -D_GLIBCXX_USE_CXX11_ABI=0
ldflags = 

rule compile
  command = cl /showIncludes $cflags -c $in /Fo$out $post_cflags
  deps = msvc

rule cuda_compile
  command = $nvcc $cuda_cflags -c $in -o $out $cuda_post_cflags



build D$:\Lab\codes\WakeNet-main\utils\_cdht\build\temp.win-amd64-3.6\Release\deep_hough_cuda.obj: compile D$:\Lab\codes\WakeNet-main\utils\_cdht\deep_hough_cuda.cpp
